<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_gpu_test.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GPU 加速测试"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1F2329"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:radius="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="测试说明"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2329"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="此工具将对比 CPU 和 GPU 推理速度\n建议先运行两次测试,再点击对比"
                android:textSize="14sp"
                android:textColor="#646A73"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnTestCpu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖥️ 测试 CPU 模式"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2196F3" />

    <Button
        android:id="@+id/btnTestGpu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎮 测试 GPU 模式"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/btnCompare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 对比性能"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#FF9800" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待测试...\n"
            android:textSize="14sp"
            android:textColor="#1F2329"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

</LinearLayout>