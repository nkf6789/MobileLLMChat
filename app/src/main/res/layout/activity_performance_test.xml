<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题栏 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔬 性能对比测试"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1F2329"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 说明卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 测试说明"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2329"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="此工具将对比不同量化版本的性能差异:\n\n• 文件大小\n• 加载速度\n• 推理速度\n• 回答质量(主观)\n\n建议先运行两个测试,再点击对比按钮"
                    android:textSize="14sp"
                    android:textColor="#646A73"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 测试按钮组 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧪 开始测试"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2329"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnTestQ3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="测试 Q3_K_M (更小更快)"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#4CAF50" />

                <Button
                    android:id="@+id/btnTestQ4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="测试 Q4_0 (平衡版)"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#2196F3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="8dp" />

                <Button
                    android:id="@+id/btnCompare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 对比结果"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#FF9800" />

                <Button
                    android:id="@+id/btnExportReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💾 导出报告"
                    android:textSize="14sp"
                    android:backgroundTint="#9C27B0" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 测试结果显示区域 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📈 测试结果"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1F2329"
                    android:layout_marginBottom="12dp" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#FAFAFA"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="等待测试...\n\n💡 提示:\n1. 点击上方按钮开始测试\n2. 每个测试需要 30-60 秒\n3. 测试完成后可以对比结果"
                        android:textSize="13sp"
                        android:textColor="#1F2329"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="4dp" />
                </ScrollView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 底部提示 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💡 测试会自动进行 5 次推理,取平均值确保准确性"
            android:textSize="12sp"
            android:textColor="#646A73"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>